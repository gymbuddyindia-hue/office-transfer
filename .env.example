# Copy to .env and edit. Every setting is optional.

# Name shown in the header and emails.
APP_NAME=Office Transfer

# Public address people will open links from. Leave empty to use whatever
# host the browser used (fine on a LAN). Set it when behind a reverse proxy.
# BASE_URL=https://transfer.yourcompany.com

# Shared code staff must type before uploading. Strongly recommended if the
# server is reachable from outside the office. Empty means anyone can upload.
UPLOAD_CODE=change-me

# Link expiry offered by default (days). Staff can pick 1 to 90 or never.
DEFAULT_EXPIRY_DAYS=7

# Hard cap per transfer in GB. 0 means no cap at all.
MAX_TRANSFER_GB=0

# Chunk size for resumable uploads in MB. 8 is a good default for office Wi-Fi.
CHUNK_SIZE_MB=8

# Unfinished uploads older than this many hours are deleted.
ABANDONED_UPLOAD_HOURS=24

# Optional: email the link to recipients. Leave SMTP_HOST empty to disable.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
# SMTP_PASS=<app password> SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Cloudflare Tunnel token for a free public HTTPS address.
# Only used by docker-compose.tunnel.yml.
TUNNEL_TOKEN=
